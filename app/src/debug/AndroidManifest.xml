<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- testing.md § 5 (L-08): the SAF stand-in of the backup tests; debug builds only, never exported. -->
        <provider
            android:name=".debug.RecordingDocumentsProvider"
            android:authorities="${applicationId}.testdocs"
            android:exported="false" />
        <!-- testing.md § 5 (L-15): the process that DbMaintenance runs in until the fault hook kills it. -->
        <service
            android:name=".debug.CrashTestService"
            android:exported="false"
            android:process=":crashtest" />
    </application>
</manifest>
